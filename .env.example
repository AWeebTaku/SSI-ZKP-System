# Copy this file to .env or set these variables in your shell.
# The launcher reads GANACHE_URL and passes it to deployment and the backend.
GANACHE_URL=http://127.0.0.1:8545
ISSUER_DID=did:ssi:issuer:national-visa-authority
DEFAULT_HOLDER_DID=did:ssi:holder:demo-traveler
# Change this outside a local demo.
ISSUER_HMAC_SECRET=replace-this-development-secret# Copy to .env and adjust as needed. The app reads these via os.environ,
# so `export`-ing them (or using `python-dotenv` / `honcho` / direnv) works.

GANACHE_URL=http://127.0.0.1:8545
ISSUER_DID=did:ssi:issuer:national-visa-authority
ISSUER_HMAC_SECRET=change-me-to-a-long-random-secret
DEFAULT_HOLDER_DID=did:ssi:holder:demo-traveler
